su.waitForElm = function(selector) {
    return new Promise(resolve => {
        if (document.querySelector(selector)) {
            return resolve(document.querySelector(selector));
        }

        const observer = new MutationObserver(mutations => {
            if (document.querySelector(selector)) {
                resolve(document.querySelector(selector));
                observer.disconnect();
            }
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    });
}

su.removeStorage = function(key) {
    try {
        localStorage.removeItem(key);
        localStorage.removeItem(key + '_expiresIn');
    } catch (e) {
        return false;
    }
    return true;
}

su.getStorage = function(key) {
    var now = Date.now();
    var expiresIn = localStorage.getItem(key + '_expiresIn');
    if (expiresIn === undefined || expiresIn === null) {
        expiresIn = 0;
    }

    if (expiresIn < now) {
        su.removeStorage(key);
        return null;
    } else {
        try {
            var value = localStorage.getItem(key);
            return value;
        } catch (e) {
            return null;
        }
    }
}

su.setStorage = function(key, value, expires) {
    if (expires === undefined || expires === null) {
        expires = (24 * 60 * 60);
    } else {
        expires = Math.abs(expires);
    }

    var now = Date.now();
    var schedule = now + expires * 1000;
    try {
        localStorage.setItem(key, value);
        localStorage.setItem(key + '_expiresIn', schedule);
    } catch (e) {
        return false;
    }
    return true;
}

su.coursesRequest = async function(courseId) {
    var stringData, course;
    let response = await fetch('/api/v1/users/self/courses?per_page=100');
    let data = await response.text();
    data = JSON.parse(data);
    stringData = JSON.stringify(data);
    su.setStorage('ga_enrollments', stringData, null);
    course = su.parseCourses(courseId, stringData);
    return course;
}

su.parseCourses = function(courseId, courseData) {
    if (courseData != undefined) {
        let data = JSON.parse(courseData);
        for (var i = 0; i < data.length; i++) {
            if (data[i]['id'] == courseId) {
                return data[i];
            }
        }
    }
    return null;
}

su.gtmCourseDimensions = function(course) {
    
    gtag('event', 'course_access', {
        'course_id': course['id'],
        'course_name': course['name'],
        'account_id': course['account_id'],
        'enrollment_term_id': course['enrollment_term_id'],
        'enrollment_type': course['enrollments'][0]['type'],
    });

    return
}

su.googleTagManagerCode = function(trackingId) {

    var userId, userRoles, attempts, courseId;

    gtag('js', new Date());
    gtag('config',  trackingId, {cookie_flags: 'SameSite=None;Secure'});

    userId = ENV["current_user_id"];
    userRoles = ENV['current_user_roles'];

    gtag('event', 'user_access', {
        'user_id': userId,
        'user_roles': userRoles
    });

    courseId = window.location.pathname.match(/\/courses\/(\d+)/);

    if (courseId) {
        courseId = courseId[1];
        attempts = 0;
        try {
            let courses = su.getStorage('ga_enrollments');
            if (courses != null) {
                var course = su.parseCourses(courseId, courses);
                if (course === null) {
                    su.coursesRequest(courseId).then(course => {
                        if (course === null) {
                        gtag('event', 'course_access', {
                            'course_id': courseId
                        });
                        } else {
                            su.gtmCourseDimensions(course)
                        }
                    });
                } else {
                    su.gtmCourseDimensions(course)
                }
            } else {
                su.coursesRequest(courseId).then(course => {
                    if (course === null) {
                    gtag('event', 'course_access', {
                        'course_id': courseId
                    });
                    } else {
                        su.gtmCourseDimensions(course)
                    }
                });
            }
        } catch (err) {
            attempts += 1;
            if (attempts > 5) {
            gtag('event', 'course_access', {
                'course_id': courseId
            });
            return;
            };
        };
    }
}

su.getCurrentUser = async function() {
    let response = await fetch('/api/v1/users/self');
    let data = await response.text();
    user = JSON.parse(data);
    return user;
}

su.getCurrentUserPermissions = async function() {
    let response = await fetch('/api/v1/accounts/self/permissions');
    let data = await response.text();
    data = JSON.parse(data);
    return data;
}

su.checkAdminLinkPermissions = function() {
    var attendanceLink = document.querySelector('nav .context_external_tool_2'),
        dataPortalLink = document.querySelector('nav .context_external_tool_25'),
        settingsLink = document.querySelector('nav .settings');

    if (attendanceLink !== null) {
        attendanceLink.parentElement.style.display = 'none';
    }
    if (dataPortalLink !== null) {
        dataPortalLink.parentElement.style.display = 'none';
    }
    if (settingsLink !== null) {
        settingsLink.parentElement.style.display = 'none';
    }

    su.getCurrentUserPermissions().then(function(permissions) {
        if (permissions.hasOwnProperty('manage_lti_add') && permissions.manage_lti_add) {
            if (attendanceLink !== null) {
                attendanceLink.parentElement.style.display = 'list-item';
            }
            if (dataPortalLink !== null) {
                dataPortalLink.parentElement.style.display = 'list-item';
            }
            if (settingsLink !== null) {
                settingsLink.parentElement.style.display = 'list-item';
            }
        }
    });
}

su.isAdminPage = function() {
    return window.location.pathname.split('/')[1] == "accounts";
}

su.isCourseHomePage = function () {
    let pathEl = window.location.pathname.split('/');
    return pathEl.length == 3 && pathEl[1] == "courses";
}

su.isWikiPage = function() {
    return window.location.pathname.split('/')[3] == "pages";
}

su.isLoginPage = function() {
    return document.querySelector('.ic-Login') !== null;
}

su.isWelshLanguage = function() {
    return document.querySelector('html[lang="cy"],html[lang="cy-gb"]') !== null;
}

su.createLanguageChanger = function() {
    var headerlinks = document.querySelector('.ic-Login-header__links'),
        languageChanger = document.createElement('a'),
        languageChangerText = su.getLanguageChangerText();

    languageChanger.setAttribute('href', "#");
    languageChanger.setAttribute('class', "ic-Login__link");
    languageChanger.setAttribute('id', "language-selector");
    languageChanger.innerHTML = languageChangerText;

    languageChanger.addEventListener('click', function(event) {

        event.preventDefault();
        su.changeLanguage();
        su.translate();
        su.updateLanguageChanger();
    }, false);

    headerlinks.appendChild(languageChanger);
}

su.getLanguageChangerText = function() {
    var lang = su.getLanguage();
    return lang === "en-gb" ? su.translations["cy-gb"].welsh : su.translations["en-gb"].english;
}

su.changeLanguage = function() {
    var lang = su.getLanguage(),
        newLang = lang === "en-gb" ? "cy-gb" : "en-gb";
    su.setLanguage(newLang);
}

su.updateLanguageChanger = function() {
    var languageChangerText = su.getLanguageChangerText();

    languageChanger = document.querySelector('#language-selector');
    languageChanger.innerHTML = languageChangerText;
}

su.getLanguage = function() {
    var html = document.querySelector('html');
    var attr = html.getAttribute('lang');
    if (null == attr) {
        attr = "en-gb";
    }
    if ("cy" == attr) {
        attr = "cy-gb";
    }
    return attr.toLowerCase();
}

su.setLanguage = function(lang) {
    var html = document.querySelector('html');

    html.setAttribute('lang', lang);
}

su.translate = function() {
    su.translateBrowseCourses();
    su.translateLoginControls();
    su.translateStaySignedIn();
    su.translateForgotPassword();

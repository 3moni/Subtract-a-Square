su.translateFooterLinks = function() {

    var footerLinks = document.querySelector('#footer-links');
    console.log(footerLinks.innerHTML);

    var lang = su.getLanguage(),
        accessibility = document.querySelector('#footer-links a[href$="canvas-swan-ac-uk/"] span'),
        help = document.querySelector('#footer-links a[href="http://help.instructure.com/"]'),
        privacy = document.querySelector('#footer-links a[href$="data-protection/"] span'),
        tos = document.querySelector('#footer-links #terms_of_service_modal a');

    if (null !== help) {
        help.innerHTML = su.translations[lang].help;
    }

    if (null !== privacy) {
        privacy.innerHTML = su.translations[lang]['privacy-policy'];
    }

    if (null !== accessibility) {
        accessibility.innerHTML = su.translations[lang]['accessibility-statement'];
    }

    if (null !== tos) {
        tos.innerHTML = su.translations[lang]['acceptable-use-policy'];
    }
}

su.replaceFooterLinks = function() {
    var privacy = document.querySelector('#footer-links a[href$="privacy_policy"]');

    if (null !== privacy) {
        privacy.href = 'https://www.swansea.ac.uk/about-us/compliance/data-protection/';
    }
}

su.customFooterLinks = function() {
    var lang = su.getLanguage();
    var container = document.getElementById('footer-links');
    if (null != container) {
        var link = document.createElement('a');
        var linkText = document.createTextNode(su.translations[lang]['accessibility-stmt']);
        link.appendChild(linkText);
        link.href = 'https://www.swansea.ac.uk/the-university/accessibility/canvas-swan-ac-uk/';
        link.target = '_blank';
        container.prepend(link);
    }
}

su.removeSocialLinks = function() {
    var facebook = document.querySelector('#footer-links a[href*="facebook"]'),
        twitter = document.querySelector('#footer-links a[href*="twitter"]');

    if (null !== facebook) {
        facebook.parentNode.removeChild(facebook);
    }

    if (null !== twitter) {
        twitter.parentNode.removeChild(twitter);
    }
}

su.removeFooterEpilogue = function() {

        swanseaDesc = swanseaLink.parentNode.lastChild;
        swanseaLink.firstChild.textContent = su.translations[lang]['help-swansea-uni'];
        swanseaDesc.textContent = su.translations[lang]['help-swansea-uni-desc'];

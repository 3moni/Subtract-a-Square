(function (i, s, o, g, r, a, m) {
    i['GoogleTagManagagerObject'] = r;
    i[r] = i[r] || function () {
        i.dataLayer = i.dataLayer || [];
        i.dataLayer.push(arguments);
    }, i[r].l = 1 * new Date();
    a = s.createElement(o),
        m = s.getElementsByTagName(o)[0];
    a.async = 1;
    a.src = g;
    m.parentNode.insertBefore(a, m)
  })(window, document, 'script', 'https://www.googletagmanager.com/gtm.js?id=GTM-W49MB3F', 'gtag');

(function(d, l, u, id){
    var ln, fln = d.getElementsByTagName(l)[0];
    if (d.getElementById(id)){ return; }
    ln = d.createElement(l); ln.id = id;
    ln.href = u;
    ln.rel = 'stylesheet';
    fln.parentNode.insertBefore(ln, fln);
}(document, 'link', 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css', 'fa-link'));

